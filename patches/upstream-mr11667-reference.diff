+static void ensure_menu_bar_layout( HWND hwnd, HMENU handle )
+{
+    struct menu *menu;
+    RECT rect;
+
+    /* Nothing to do if we don't get the menu */
+    if (!(menu = grab_menu_ptr( handle )))
+        return;
+
+    rect = menu->items_rect;
+    /* Nothing to do if the menu height is non-zero or the items_rect is empty */
+    if (menu->Height || IsRectEmpty( &rect ))
+    {
+        release_menu_ptr( menu );
+        return;
+    }
+
+    release_menu_ptr( menu );
+    /* A menu bar with zero height but non-empty items_rect needs updating */
+    update_menu_bar_layout( hwnd, rect.right - rect.left, rect.left, rect.top );
+}
